# QQ Bot Admin System - Environment Variables

# Database Configuration
DB_PASSWORD=qq_bot_secure_password_2024
DATABASE_URL=postgresql://bot_admin:qq_bot_secure_password_2024@postgres:5432/qq_bot
POSTGRES_DB=qq_bot
POSTGRES_USER=bot_admin
POSTGRES_PASSWORD=qq_bot_secure_password_2024
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Configuration
JWT_SECRET=your_super_secret_jwt_key_that_should_be_at_least_32_characters_long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# DeepSeek API Configuration
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_EMBEDDING_MODEL=text-embedding-3-small

# QQ Bot Configuration (NapCatQQ)
BOT_QQ_NUMBER=123456789
BOT_QQ_PASSWORD=your_qq_password

# NapCatQQ Configuration
NAPCAT_HTTP_URL=http://napcat:3001
NAPCAT_WS_URL=ws://napcat:3002
NAPCAT_ACCESS_TOKEN=

# NoneBot2 Configuration
NB_HOST=0.0.0.0
NB_PORT=8080

# Bot Admin QQ Numbers (comma-separated)
BOT_ADMIN_QQS=10001,10002

# Service URLs
BACKEND_URL=http://localhost:8000
FRONTEND_URL=http://localhost:3000
BOT_URL=http://bot:8080

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# AI Configuration
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=2000
AI_CONTEXT_GROUP=10
AI_CONTEXT_PRIVATE=20

# Message Cache TTL (seconds)
MESSAGE_CACHE_TTL=120

# Log Level
LOG_LEVEL=INFO
LOG_FORMAT=json

# Environment
NODE_ENV=development
ENVIRONMENT=development

# Security
SECRET_KEY=another_secret_key_for_additional_security
ALGORITHM=HS256
